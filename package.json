{
  "name": "nelly-api",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ov1:rotation": "node scripts/ov1-rotation-3-drivers.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit --cacheDirectory=.jest-cache",
    "deploy": "firebase deploy",
    "validate:flow": "node .codex-tmp/validate-fresh-delivery-flow.mjs",
    "validate:routes": "node scripts/validation/validate-routes.js",
    "validate:data-model": "node scripts/validation/validate-data-model.js",
    "validate:contracts": "node scripts/validation/validate-contracts.js",
    "validate:domain-contracts": "node scripts/validation/validate-domain-contracts.js",
    "validate:firebase": "node scripts/validation/validate-firebase.js",
    "validate:operational-port": "node scripts/validation/validate-operational-port.js",
    "validate:panels-pre-pilot": "node scripts/validation/validate-panels-pre-pilot.mjs",
    "validate:all": "npm run validate:routes && npm run validate:data-model && npm run validate:contracts && npm run validate:domain-contracts && npm run validate:firebase",
    "doctor": "node scripts/validation/doctor.js",
    "doctor:operational": "node scripts/validation/operational-doctor.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.8.0",
    "geolib": "^3.3.14",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "jest": "^30.3.0",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2"
  }
}
