# Variables de entorno requeridas para Nelly API
# Copia este archivo como .env y completa con tus claves reales

# OpenAI API Key (para chat IA)
OPENAI_API_KEY=tu_clave_openai_aqui

# MercadoPago Access Token
MP_ACCESS_TOKEN=tu_token_mercadopago_aqui

# Firebase Database URL
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# Google Maps API Key (para mapas y geolocalización)
GOOGLE_MAPS_API_KEY=tu_clave_google_maps_aqui

# Resend API Key (para emails)
RESEND_API_KEY=tu_clave_resend_aqui

# URL de Render (para keep-alive)
RENDER_URL=https://tu-app.onrender.com

# Entorno (development/production)
NODE_ENV=development
