rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo usuarios autenticados pueden leer/escribir evidencias de su pedido
    match /evidencias/{pedidoId}.jpg {
      allow read, write: if request.auth != null && (
        // El usuario es admin, cliente o repartidor del pedido
        exists(/databases/(default)/documents/pedidos/$(pedidoId)) && (
          get(/databases/(default)/documents/pedidos/$(pedidoId)).data.clienteId == request.auth.uid ||
          get(/databases/(default)/documents/pedidos/$(pedidoId)).data.repartidorId == request.auth.uid ||
          get(/databases/(default)/documents/admins/$(request.auth.uid)).exists()
        )
      );
    }
    // Otras reglas...
  }
}