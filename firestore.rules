rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo conductores autenticados pueden ver sus propios pedidos
    match /pedidos/{pedidoId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.conductorId;
      allow create: if request.auth != null;
    }
    // Zonas son públicas para lectura, pero solo admin escribe
    match /zonas/{zonaId} {
      allow read: if request.auth != null;
      allow write: if false; // Solo vía Panel Admin
    }
  }
}
