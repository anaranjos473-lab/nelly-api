rules_version = '2';

// Nelly Delivery v1.0 — Reglas de Firestore
// Desplegadas via GitHub Actions (firebase-deploy.yml)
// auth != null requerido para todas las colecciones operativas

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden leer/escribir pedidos
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Métricas de ganancias — solo lectura autenticada
    match /metricas/{metricaId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // Regla para Expansión de Negocio (Puntos Ciegos)
    match /puntos_ciegos/{puntoId} {
      // Solo usuarios con cuenta en la app pueden registrar su ubicación
      allow create: if request.auth != null;
      // Solo tú (Admin) puedes ver y analizar los puntos de calor
      allow read: if request.auth != null && request.auth.token.admin == true;
      // Prohibido editar o borrar datos de analítica para mantener integridad
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
