{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/panel", "destination": "/panel.html" },
      { "source": "/", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "database": {
    "rules": "security_rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  }
}
