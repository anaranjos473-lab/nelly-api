{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/admin-dashboard.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/js/admin-dashboard.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/panel.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/os", "destination": "/os.html" },
      { "source": "/nellydelivery", "destination": "/os.html" },
      { "source": "/nellydelivery/panel", "destination": "/panel.html" },
      { "source": "/nellydelivery/cocina", "destination": "/panel.html" },
      { "source": "/nellydelivery/admin", "destination": "/admin-dashboard.html" },
      { "source": "/nellydelivery/operativo", "destination": "/dashboard-operativo.html" },
      { "source": "/nellydelivery/comercial", "destination": "/dashboard-comercial.html" },
      { "source": "/nellydelivery/crm", "destination": "/crm-basico.html" },
      { "source": "/nellydelivery/repartidor", "destination": "/repartidor.html" },
      { "source": "/administrar", "destination": "/admin-dashboard.html" },
      { "source": "/admin", "destination": "/admin-dashboard.html" },
      { "source": "/admin-dashboard", "destination": "/admin-dashboard.html" },
      { "source": "/operaciones", "destination": "/dashboard-operativo.html" },
      { "source": "/operar", "destination": "/dashboard-operativo.html" },
      { "source": "/control", "destination": "/dashboard-operativo.html" },
      { "source": "/cocina", "destination": "/panel.html" },
      { "source": "/kitchen", "destination": "/panel.html" },
      { "source": "/comercio", "destination": "/dashboard-comercial.html" },
      { "source": "/tienda", "destination": "/dashboard-comercial.html" },
      { "source": "/commerce", "destination": "/dashboard-comercial.html" },
      { "source": "/logistica", "destination": "/repartidor.html" },
      { "source": "/driver", "destination": "/repartidor.html" },
      { "source": "/finanzas", "destination": "/finanzas.html" },
      { "source": "/finance", "destination": "/finanzas.html" },
      { "source": "/nellydelivery/finanzas", "destination": "/finanzas.html" },
      { "source": "/crm", "destination": "/crm-basico.html" },
      { "source": "/analytics", "destination": "/analytics.html" },
      { "source": "/developer", "destination": "/developer.html" },
      { "source": "/tracking", "destination": "/seguimiento.html" },
      { "source": "/cliente", "destination": "/seguimiento.html" },
      { "source": "/panel", "destination": "/panel.html" },
      { "source": "/", "destination": "/os.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "database": {
    "rules": "security_rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    }
  }
}
