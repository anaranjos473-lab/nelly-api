<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name="com.example.nellydriver.NellyApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.NellyDriver"
        android:supportsRtl="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDUppCEqg5YQ4UvTNxGQHRUy4H2YA3t08Q" />

        <service
            android:name=".service.DeliveryTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name="com.example.nellydriver.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.pedidos.PedidosDisponiblesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operaciones.CentroOperacionesActivity"
            android:exported="false" />
    </application>

</manifest>
